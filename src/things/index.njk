---
layout: base.njk
pagination:
    data: locales
    size: 1
    alias: lang
permalink: "{{ '/things/' | localeUrl(lang) }}"
eleventyComputed:
    title: "{{ i18n[lang].sections.things }} — {{ i18n[lang].siteTitle }}"
---
<section class="section-things">
    <h3 class="section-things__heading">{{ i18n[lang].sections.things }}</h3>
    <p>{{ i18n[lang].thingsSubtitle }}</p>
    <div class="section-things__list">
        {%- for post in collections.things | reverse %}
        {%- if post.data.lang == lang %}
        <article class="card">
            <h4 class="card__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h4>
            <span>{{ post.data.description }}</span>
            {%- if post.data.tags | displayTags | length %}
            <div class="card__tags">
                {%- for t in post.data.tags | displayTags %}
                <a href="{{ ('/things/tag/' + (t | slugify) + '/') | localeUrl(lang) }}" class="card__tag">#{{ t }}</a>
                {%- endfor %}
            </div>
            {%- endif %}
        </article>
        {%- endif %}
        {%- endfor %}
    </div>
</section>
